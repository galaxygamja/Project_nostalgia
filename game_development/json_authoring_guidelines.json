    "examples": [
      {
        "id": "ISBO_001",
        "interpretation": "인카운터, 스토리, 기지, 1회성, 해당 조합의 첫 번째 데이터"
      },
      {
        "id": "IROS_001",
        "interpretation": "사용 불가 예시. 추천 문자표의 네 번째 위치에는 S가 등록되어 있지 않으므로 유효성 검사에서 거부한다."
      },
      {
        "id": "IRSC_003",
        "interpretation": "인카운터, 랜덤, 수면, 쿨다운, 해당 조합의 세 번째 데이터"
      },
      {
        "id": "CMEB_001",
        "interpretation": "캐릭터, 주요 인물, 기술 전문, 기지 소속, 해당 조합의 첫 번째 데이터"
      }
    ]
  },
  "shared_structures": {
    "time_position": {
      "required_fields": {
        "day_index": "integer, 0~999",
        "slot_index": "integer, 0~47"
      },
      "example": {
        "day_index": 0,
        "slot_index": 12
      }
    },
    "requirements": {
      "all_fields_optional": true,
      "fields": {
        "required_flags": "array[string]",
        "excluded_flags": "array[string]",
        "required_item_ids": "array[id]",
        "required_character_ids": "array[id]",
        "required_facility_ids": "array[id]",
        "minimum_values": "object[path -> number]",
        "maximum_values": "object[path -> number]",
        "time_ranges": "array[{start_slot, end_slot}]",
        "condition_formula_id": "formula id or null"
      },
      "evaluation_rule": "기본적으로 모든 조건을 동시에 만족해야 한다. 복합 OR 조건은 condition_formula_id를 사용한다.",
      "example": {
        "required_flags": [
          "generator_access"
        ],
        "excluded_flags": [
          "generator_destroyed"
        ],
        "required_item_ids": [
          "MXXX_001"
        ],
        "minimum_values": {
          "commander.health": 10.0,
          "commander.stress": 70.0
        },
        "time_ranges": [
          {
            "start_slot": 36,
            "end_slot": 47
          },
          {
            "start_slot": 0,
            "end_slot": 11
          }
        ]
      }
    },
    "effect": {
      "required_fields": {
        "target": "string, 변경 대상 경로",
        "operation": "set, add, subtract, multiply, divide, add_id, remove_id 중 하나",
        "value": "number, boolean, string, id 또는 배열"
      },
      "optional_fields": {
        "value_formula_id": "고정 value 대신 사용할 계산식 ID",
        "clamp": "{minimum, maximum}",
        "requirements": "효과 자체가 실행되기 위한 조건"
      },
      "target_path_examples": [
        "commander.stress",
        "character:CMEB_001.fatigue",
        "facility:FXXX_001.condition",
        "resource:RXXX_001.current_value",
        "flag.generator_access",
        "inventory.items"
      ],
      "example": {
        "target": "facility:FXXX_001.condition",
        "operation": "add",
        "value": -10.0,
        "clamp": {
          "minimum": 0.0,
          "maximum": 100.0
        }
      }
    },
    "repeat_policy": {
      "allowed_types": [
        "one_time",
        "repeatable",
        "daily_once",
        "cooldown",
        "until_result"
      ],
      "fields": {
        "type": "required string",
        "cooldown_slots": "cooldown일 때 required integer",
        "remove_after_draw": "boolean",
        "reset_at_day_change": "boolean"
      },
      "example": {
        "type": "cooldown",
        "cooldown_slots": 48,
        "remove_after_draw": false,
        "reset_at_day_change": false
      }
    },
    "formula_expression": {
      "rule": "문자열 GDScript를 실행하지 않고 허용된 연산자로 이루어진 표현식 트리를 사용한다.",
      "value_nodes": {
        "constant": {
          "constant": 10.0
        },
        "variable": {
          "variable": "assignee.skill"
        },
        "operation": {
          "operator": "add",
          "values": [
            {
              "constant": 10.0
            },
            {
              "variable": "assignee.skill"
            }
          ]
        }
      },
      "allowed_numeric_operators": [
        "add",
        "subtract",
        "multiply",
        "divide",
        "minimum",
        "maximum",
        "clamp",
        "floor",
        "ceil",
        "round"
      ],
      "allowed_condition_operators": [
        "equal",
        "not_equal",
        "greater",
        "greater_or_equal",
        "less",
        "less_or_equal",
        "and",
        "or",
        "not"
      ],
      "safety_rules": [
        "divide의 두 번째 값이 0이 될 수 있으면 fallback_value를 지정한다.",
        "허용되지 않은 변수 경로와 연산자는 로딩 단계에서 거부한다.",
        "표현식 최대 깊이는 기본 32단계로 제한한다.",
        "공식 간 재귀 참조를 금지한다."
      ]
    }
  },
  "file_specs": {
    "id_code_rules.json": {
      "purpose": "4자리 조합형 ID에서 각 위치의 허용 문자와 의미를 정의하는 유일한 기준 파일",
      "required_top_level_fields": [
        "schema_version",
        "data_type",
        "data_types"
      ],
      "example": {
        "schema_version": 1,
        "data_type": "id_code_rules",
        "data_types": {
          "I": {
            "name": "encounter",
            "positions": {
              "2": {
                "S": "story",
                "R": "random",
                "F": "fixed_schedule",
                "E": "emergency"
              },
              "3": {
                "B": "base",
                "O": "outdoor",
                "S": "sleep",
                "D": "deduction",
                "C": "character"
              },
              "4": {
                "O": "one_time",
                "R": "repeatable",
                "C": "cooldown",
                "D": "daily_once"
              }
            }
          }
        }
      }
    },
    "game_config.json": {
      "purpose": "시간, 시작 위치, 데이터 경로 등 전역 설정 정의",
      "required_fields": [
        "max_days",
        "slots_per_day",
        "minutes_per_slot",
        "start_day_index",
        "start_slot_index",
        "id_pattern",
        "paths"
      ],
      "example": {
        "schema_version": 1,
        "data_type": "game_config",
        "game": {
          "max_days": 1000,
          "slots_per_day": 48,
          "minutes_per_slot": 30,
          "start_day_index": 0,
          "start_slot_index": 12,
          "id_pattern": "^[A-Z]{4}_[0-9]{3}$"
        },
        "paths": {
          "initial_state": "res://data/initial/initial_game_state.json",
          "timetable": "res://data/timeline/timetable.json",
          "id_code_rules": "res://data/config/id_code_rules.json"
        }
      }
    },
    "initial_game_state.json": {
      "purpose": "create_new_game()이 읽을 새 게임 초기 상태와 활성 데이터 목록 정의",
      "required_initial_state_fields": [
        "current_time",
        "commander_id",
        "active_character_ids",
        "resource_values",
        "facility_states",
        "character_overrides",
        "initial_task_ids",
        "active_pool_ids",
        "inventory",
        "clue_ids",
        "deduction_ids",
        "flags"
      ],
      "rules": [
        "정의 파일의 default_state를 먼저 복사하고 override를 적용한다.",
        "초기 상태 파일에 정의 전체를 중복 작성하지 않는다.",
        "모든 참조 ID는 정의 저장소에 존재해야 한다."
      ],
      "example": {
        "schema_version": 1,
        "data_type": "initial_game_state",
        "initial_state": {
          "current_time": {
            "day_index": 0,
            "slot_index": 12
          },
          "commander_id": "CMCB_001",
          "active_character_ids": [
            "CMEB_001",
            "CMMB_001",
            "CMXO_001",
            "CMRB_001",
            "CMAB_001"
          ],
          "resource_values": {
            "RXXX_001": 1840.0,
            "RXXX_002": 9260.0,
            "RXXX_003": 100.0,
            "RXXX_004": 72.0,
            "RXXX_005": 143.0,
            "RXXX_006": 28.0
          },
          "facility_states": {
            "FXXX_001": {
              "condition": 85.0,
              "efficiency": 90.0,
              "operational": true
            }
          },
          "character_overrides": {
            "CMCB_001": {
              "condition": 70.0,
              "stress": 20.0,
              "health": 100.0,
              "awake_slots": 2
            }
          },
          "initial_task_ids": [],
          "active_pool_ids": [
            "PXXX_001",
            "PXXX_002"
          ],
          "inventory": {
            "MXXX_001": 1
          },
          "clue_ids": [],
          "deduction_ids": [],
          "flags": {
            "tutorial_completed": false,
            "ai_intrusion_level": 0
          }
        }
      }
    },
    "timetable.json": {
      "purpose": "1000일 시간표, 특정 시각 예약 사건, 반복 고정 일정 정의",
      "storage_policy": "논리적으로는 time_table[day_index][slot_index]지만 파일은 일정이 있는 슬롯만 기록하는 희소 구조를 권장한다.",
      "required_fields": [
        "max_days",
        "slots_per_day",
        "days",
        "repeating_schedules"
      ],
      "day_entry_fields": {
        "day_index": "integer, 0~999",
        "slots": "object, 키는 문자열 형태의 0~47 슬롯 번호"
      },
      "slot_fields": {
        "fixed_schedule_ids": "array[id]",
        "scheduled_encounter_ids": "array[id]",
        "task_completion_ids": "array[runtime task instance id]"
      },
      "example": {
        "schema_version": 1,
        "data_type": "timetable",
        "max_days": 1000,
        "slots_per_day": 48,
        "days": [
          {
            "day_index": 19,
            "slots": {
              "28": {
                "fixed_schedule_ids": [],
                "scheduled_encounter_ids": [
                  "ISBO_020"
                ],
                "task_completion_ids": []
              }
            }
          }
        ],
        "repeating_schedules": [
          {
            "schedule_id": "SXXX_001",
            "start_day_index": 0,
            "end_day_index": 999,
            "slot_index": 12,
            "interval_days": 1
          },
          {
            "schedule_id": "SXXX_002",
            "start_day_index": 0,
            "end_day_index": 999,
            "slot_index": 44,
            "interval_days": 1
          }
        ]
      }
    },
    "resources.json": {
      "purpose": "기지 자원의 표시, 범위, 생산, 소비, 위험 기준 정의",
      "required_entry_fields": [
        "id",
        "name",
        "unit",
        "value_type",
        "minimum",
        "maximum",
        "default_value",
        "production_per_slot",
        "consumption_per_slot",
        "critical_threshold",
        "display_as_percentage"
      ],
      "example": {
        "schema_version": 1,
        "data_type": "resource",
        "entries": [
          {
            "id": "RXXX_001",
            "name": "식량",
            "unit": "kg",
            "value_type": "float",
            "minimum": 0.0,
            "maximum": 10000.0,
            "default_value": 1840.0,
            "production_per_slot": 0.0,
            "consumption_per_slot": 2.5,
            "critical_threshold": 300.0,
            "display_as_percentage": false
          }
        ]
      }
