                },
                {
                  "operator": "add",
                  "values": [
                    {
                      "variable": "task.difficulty"
                    },
                    {
                      "operator": "multiply",
                      "values": [
                        {
                          "variable": "assignee.fatigue"
                        },
                        {
                          "constant": 0.3
                        }
                      ]
                    },
                    {
                      "operator": "multiply",
                      "values": [
                        {
                          "variable": "assignee.stress"
                        },
                        {
                          "constant": 0.2
                        }
                      ]
                    }
                  ]
                }
              ]
