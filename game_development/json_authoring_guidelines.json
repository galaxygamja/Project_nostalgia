{
  "document": {
    "title": "게임 데이터 JSON 제작 지침",
    "schema_version": 1,
    "target_engine": "Godot 4.7.1",
    "language": "ko-KR",
    "purpose": "게임에 사용되는 모든 JSON 정의 파일을 일관된 형식으로 작성하기 위한 단일 규격서",
    "important_notes": [
      "JSON은 데이터를 보관하며 계산을 직접 실행하지 않는다.",
      "계산식, 조건식, 효과는 JSON에 구조화된 데이터로 작성하고 Godot의 해석기가 실행한다.",
      "새 게임 생성 시 create_new_game()은 initial_game_state.json을 읽어 런타임 상태에 값을 대입한다.",
      "저장 및 불러오기 형식은 현재 규격의 범위에서 제외한다.",
      "시간은 30분 단위이며 최대 1000일, 하루 48슬롯, 전체 48000슬롯이다.",
      "시간표는 JSON 원본 데이터로 보관하며 새 게임 생성 시 코드로 48000개 슬롯을 생성하지 않는다.",
      "action의 delegate_allowed와 required_skill은 선택 필드다. 누락하면 책임자만 수행 가능하며 요구 기술도 없는 기존 행동으로 해석한다.",
      "업무 계산식의 facility.bonus는 해당 업무 target_id 시설의 현재 efficiency 값으로 해석한다."
    ]
  },
  "global_rules": {
    "encoding": "UTF-8 without BOM 권장",
    "file_extension": ".json",
    "indentation": "공백 2칸",
    "property_naming": "snake_case",
    "id_naming": "대문자 알파벳 4자리, 밑줄, 숫자 3자리",
    "id_regex": "^[A-Z]{4}_[0-9]{3}$",
    "time_unit": "slot",
    "minutes_per_slot": 30,
    "day_index_range": {
      "minimum": 0,
      "maximum": 999,
      "display_rule": "화면에는 day_index + 1을 DAY 번호로 표시한다."
    },
    "slot_index_range": {
      "minimum": 0,
      "maximum": 47,
      "examples": {
        "0": "00:00",
        "1": "00:30",
        "12": "06:00",
        "27": "13:30",
        "44": "22:00",
        "47": "23:30"
      }
    },
    "absolute_slot_formula": "day_index * 48 + slot_index",
    "json_restrictions": [
      "주석을 사용하지 않는다.",
      "후행 쉼표를 사용하지 않는다.",
      "NaN, Infinity, 함수, GDScript 코드를 값으로 넣지 않는다.",
      "날짜와 시간은 표시 문자열이 아니라 day_index와 slot_index로 저장한다.",
      "다른 데이터를 참조할 때 표시 이름 대신 ID를 사용한다.",
      "동일한 정의 ID를 둘 이상의 파일에 중복 선언하지 않는다.",
      "정수와 실수의 의미를 구분하되 Godot JSON 파싱 후 필요한 자료형으로 명시적으로 변환한다."
    ],
    "common_file_wrapper": {
      "required_fields": {
        "schema_version": "integer, 1 이상",
        "data_type": "string, 파일에 포함된 데이터 종류",
        "entries": "array, 실제 정의 목록"
      },
      "example": {
        "schema_version": 1,
        "data_type": "example_type",
        "entries": []
      }
    }
  },
  "id_system": {
    "structure": "ABCD_001",
    "meaning": {
      "A": "첫 번째 분류 문자. 데이터의 대분류를 나타낸다.",
      "B": "두 번째 분류 문자. 첫 번째 문자에 종속된 하위 분류를 나타낸다.",
      "C": "세 번째 분류 문자. 첫 번째 문자에 종속된 환경, 역할 또는 영역을 나타낸다.",
      "D": "네 번째 분류 문자. 첫 번째 문자에 종속된 반복 정책, 중요도 또는 세부 분류를 나타낸다.",
      "001": "동일한 4자리 문자 조합 안에서의 일련번호"
    },
    "rules": [
      "네 문자는 단어의 네 글자 축약이 아니라 각각 별도의 분류값이다.",
      "각 위치의 의미는 첫 번째 데이터 대분류 문자에 따라 달라질 수 있다.",
      "사용하지 않는 분류 위치에는 X를 사용한다.",
      "일련번호 000은 시스템 예약 번호로 비워두고 001부터 사용하는 것을 권장한다.",
      "한 번 배포한 ID는 이름이나 내용이 바뀌더라도 재사용하거나 변경하지 않는다.",
      "삭제한 ID의 번호는 다른 데이터에 다시 할당하지 않는다.",
      "실제 프로젝트에서 사용할 문자표는 id_code_rules.json을 유일한 기준으로 삼는다."
    ],
